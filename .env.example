OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
# 图片识题用的视觉模型；DeepSeek 官方 Vision 文档目前支持 deepseek-flash
OPENAI_VISION_MODEL=deepseek-flash
# 留空表示不传 temperature，沿用接口默认值。
# 实测设为 0 会让模型反复重试同一个失败的 sympy 验证，不建议。
OPENAI_TEMPERATURE=
# 可选：DeepSeek 推理强度。none 可显著降低延迟；留空沿用接口默认。
OPENAI_REASONING_EFFORT=

# 图片识题默认复用 DeepSeek 视觉模型（同一个 Key），不需要安装 Ollama：
OCR_PROVIDER=deepseek

# 可选：本机 Ollama，免费且图片不出本机；需要先安装 Ollama：
#   ollama pull glm-ocr      # 约 2.7 GB，只需下载一次
#   ollama serve             # 或直接打开 Ollama 应用
# 使用前把 OCR_PROVIDER 改成 ollama。
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_OCR_MODEL=glm-ocr
# 留空使用 GLM-OCR 自带的整页识别提示；换通用视觉模型时可自定义
OLLAMA_OCR_PROMPT=
# 秒；首次加载模型较慢，建议不低于 120
OLLAMA_OCR_TIMEOUT=240
# 上下文窗口。默认值过小会让整页图片把窗口占满，输出被截断
OLLAMA_OCR_NUM_CTX=16384

# 可选备选：第三方云端 SimpleTex（图片会离开本机，并按账户额度计费）。
# 两种鉴权任选其一：
# 1) 用户中心创建“用户授权令牌”（AT 开头），本地自用最省事；
# 2) 开放平台应用的 APP ID / SECRET，服务端按官方规则签名。
# 使用前把 OCR_PROVIDER 改成 simpletex。
SIMPLETEX_TOKEN=
SIMPLETEX_APP_ID=
SIMPLETEX_APP_SECRET=
# simpletex_ocr：整页图文混排（默认，适合题目截图）
# latex_ocr / latex_ocr_turbo：只识别公式，不识别中文题干
SIMPLETEX_MODE=simpletex_ocr

# 知识库（仓库自带，见 kb/）
CMC_INDEX_PATH=kb/problems.jsonl
CMC_ANSWERS_PATH=kb/answers.jsonl
CMC_EMBEDDINGS_PATH=kb/embeddings.npz
CMC_LATEX_PATH=kb/question_latex.json

# BGE 模型（仓库自带，Git LFS 管理）
CMC_EMBEDDING_MODEL=models/bge-small-zh-v1.5
CMC_MODEL_CACHE=models
HF_HOME=models/hf-cache
# auto：有向量缓存时 BM25+BGE+RRF，否则回退 BM25；也可设 bm25/vector/hybrid
CMC_RETRIEVER=auto
# 默认不加查询指令；官方建议值为“为这个句子生成表示以用于检索相关文章：”
CMC_QUERY_PREFIX=

# 会话持久化：默认写到 data/sessions.db，刷新页面/重启服务后可恢复。
# 本地临时调试可设为 off，退回纯内存模式。
CMC_SESSION_DB=data/sessions.db

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# 可选：向量检索。不配置时 build_embeddings 使用 Hugging Face 默认缓存。
CMC_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
CMC_MODEL_CACHE=
HF_HOME=
CMC_EMBEDDINGS_PATH=data/processed/embeddings.npz
# auto：有向量缓存时 BM25+BGE+RRF，否则回退 BM25；也可设 bm25/vector/hybrid
CMC_RETRIEVER=auto
# 默认不加查询指令；官方建议值为“为这个句子生成表示以用于检索相关文章：”
CMC_QUERY_PREFIX=
